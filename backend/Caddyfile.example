# Snippet to paste into your existing Caddyfile.
#
# This assumes Caddy itself runs in a container and shares a Docker network
# with the livepos container (see compose.yaml). The reverse-proxy target is
# the livepos container's name, resolved via Docker's built-in DNS.
#
# Make sure backend.tarif.ist has an A record pointing at the VPS, and that
# Cloudflare DNS for that record is set to "DNS only" (grey cloud) so Caddy
# can complete the Let's Encrypt HTTP-01 / TLS-ALPN-01 challenge.

backend.tarif.ist {
	encode zstd gzip

	reverse_proxy tarif-ist-livepos:8080 {
		health_uri      /healthz
		health_interval 30s
		health_timeout  5s
	}

	log {
		output file /var/log/caddy/backend.tarif.ist.log
		format json
	}
}
